using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Runtime.CompilerServices;
using WindowTest.Models;
using WindowTest.Services;

namespace WindowTest.ViewModels;

public class QuizViewModel : INotifyPropertyChanged
{
    private readonly List<Question> _questions;
    private readonly List<string> _strategyNames;
    private int _currentIndex;
    private int _score;
    private bool _isCompleted;
    private bool _isSubmitted;
    private string _selectedStrategy = "Base Quiz";

    public QuizViewModel()
    {
        _questions = QuestionCatalog.GetQuestions();
        _strategyNames = new List<string>
        {
            "Base Quiz",
            "Parsa 52 Line Turn",
            "BTC 52 Candle Regime",
            "Drive Book Master",
        };

        StrategyOptions = new ObservableCollection<string>(_strategyNames);
        CurrentOptions = new ObservableCollection<string>();
        SelectedAnswerIndex = -1;
        CurrentQuestion = null;
    }

    public event PropertyChangedEventHandler? PropertyChanged;

    public ObservableCollection<string> StrategyOptions { get; }
    public ObservableCollection<string> CurrentOptions { get; }

    public Question? CurrentQuestion { get; private set; }

    public int Score
    {
        get => _score;
        private set
        {
            if (_score != value)
            {
                _score = value;
                OnPropertyChanged();
                OnPropertyChanged(nameof(ScoreText));
            }
        }
    }

    public int CurrentIndex
    {
        get => _currentIndex;
        private set
        {
            if (_currentIndex != value)
            {
                _currentIndex = value;
                OnPropertyChanged();
                OnPropertyChanged(nameof(ProgressText));
            }
        }
    }

    public int TotalQuestions => _questions.Count;

    public string SelectedStrategy
    {
        get => _selectedStrategy;
        set
        {
            if (_selectedStrategy != value)
            {
                _selectedStrategy = value;
                OnPropertyChanged();
                RefreshStrategySummary();
            }
        }
    }

    public bool IsCompleted
    {
        get => _isCompleted;
        private set
        {
            if (_isCompleted != value)
            {
                _isCompleted = value;
                OnPropertyChanged();
            }
        }
    }

    public bool IsSubmitted
    {
        get => _isSubmitted;
        private set
        {
            if (_isSubmitted != value)
            {
                _isSubmitted = value;
                OnPropertyChanged();
                OnPropertyChanged(nameof(CanSubmit));
                OnPropertyChanged(nameof(CanNext));
            }
        }
    }

    public bool CanSubmit => !IsSubmitted && !IsCompleted;
    public bool CanNext => IsSubmitted && !IsCompleted;

    public string ScoreText => $"Score: {Score}";
    public string ProgressText => $"Question {Math.Min(CurrentIndex + 1, TotalQuestions)} / {TotalQuestions}";
    public int SelectedAnswerIndex { get; set; }
    public string StrategyTitle => GetStrategySpec().TitleFa;
    public string StrategySummary => GetStrategySpec().SpecialEdgeAdvantageFa;
    public string ResultSummary => IsCompleted
        ? $"Final result: {Score} / {TotalQuestions} ({Percentage:F1}%)"
        : "";
    public double Percentage => TotalQuestions > 0 ? (Score * 100.0) / TotalQuestions : 0.0;

    public void Initialize()
    {
        Score = 0;
        CurrentIndex = 0;
        IsCompleted = false;
        IsSubmitted = false;
        LoadCurrentQuestion();
    }

    public void RefreshStrategySummary()
    {
        OnPropertyChanged(nameof(StrategyTitle));
        OnPropertyChanged(nameof(StrategySummary));
    }

    public void LoadCurrentQuestion()
    {
        if (_questions.Count == 0)
        {
            IsCompleted = true;
            return;
        }

        CurrentQuestion = _questions[CurrentIndex];
        CurrentOptions.Clear();
        foreach (var option in CurrentQuestion.Answers)
        {
            CurrentOptions.Add(option);
        }

        SelectedAnswerIndex = -1;
        IsSubmitted = false;

        OnPropertyChanged(nameof(CurrentQuestion));
        OnPropertyChanged(nameof(ScoreText));
        OnPropertyChanged(nameof(ProgressText));
        OnPropertyChanged(nameof(StrategyTitle));
        OnPropertyChanged(nameof(StrategySummary));
    }

    public bool SubmitCurrentAnswer()
    {
        if (CurrentQuestion is null || IsSubmitted || IsCompleted)
        {
            return false;
        }

        var selected = SelectedAnswerIndex;
        if (selected < 0 || selected >= CurrentQuestion.Answers.Count)
        {
            return false;
        }

        IsSubmitted = true;

        if (selected == CurrentQuestion.CorrectIndex)
        {
            Score += 1;
        }

        OnPropertyChanged(nameof(ScoreText));
        OnPropertyChanged(nameof(ResultSummary));
        OnPropertyChanged(nameof(CanSubmit));
        OnPropertyChanged(nameof(CanNext));
        return true;
    }

    public void GoToNextQuestion()
    {
        if (CurrentIndex < _questions.Count - 1)
        {
            CurrentIndex += 1;
            LoadCurrentQuestion();
            return;
        }

        IsCompleted = true;
        OnPropertyChanged(nameof(ResultSummary));
        OnPropertyChanged(nameof(CanSubmit));
        OnPropertyChanged(nameof(CanNext));
        OnPropertyChanged(nameof(ProgressText));
    }

    private DriveBookPlaybookSpec GetStrategySpec()
    {
        return SelectedStrategy switch
        {
            "Parsa 52 Line Turn" => QuizStrategyCatalog.GetSpec(QuizModelType.PARSA_52_LINE_TURN),
            "BTC 52 Candle Regime" => QuizStrategyCatalog.GetSpec(QuizModelType.BTC_52_CANDLE_REGIME),
            "Drive Book Master" => QuizStrategyCatalog.GetSpec(QuizModelType.DRIVE_BOOKS_1_TO_9_UNIFIED_MASTER),
            _ => QuizStrategyCatalog.GetSpec(QuizModelType.BASE_QUIZ),
        };
    }

    private void OnPropertyChanged([CallerMemberName] string? name = null)
    {
        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
    }
}
